{
  "$schema": "https://typedoc.org/schema.json",
  "customFooterHtml": "Generated from the <code>main</code> branch of <a href=\"https://github.com/solana-mobile/skr-js\">solana-mobile/skr-js</a>.",
  "entryPointStrategy": "packages",
  "entryPoints": ["../packages/*"],
  "hostedBaseUrl": "https://solana-mobile.github.io/skr-js/",
  "includeVersion": true,
  "name": "skr-js",
  "outputs": [
    {
      "name": "html",
      "path": "../dist/api"
    },
    {
      "name": "markdown",
      "path": "../dist/api/md"
    }
  ],
  "packageOptions": {
    "basePath": "../..",
    "disableGit": true,
    "displayBasePath": "../..",
    "entryPoints": ["src/index.ts"],
    "excludeExternals": true,
    "excludeInternal": true,
    "excludePrivate": true,
    "gitRevision": "main",
    "includeVersion": true,
    "sourceLinkTemplate": "https://github.com/solana-mobile/skr-js/blob/{gitRevision}/{path}#L{line}"
  },
  "packagesRequiringDocumentation": ["@solana-mobile/skr-domain", "@solana-mobile/skr-genesis-token"],
  "plugin": ["typedoc-plugin-markdown", "typedoc-plugin-mdn-links"],
  "readme": "../README.md",
  "treatWarningsAsErrors": true,
  "validation": {
    "invalidLink": true,
    "notDocumented": true,
    "notExported": true,
    "rewrittenLink": true
  }
}
